# CONTENT / CLIPPER / DISTRIBUTOR DATABASE ONLY
SUPABASE_URL=https://xdidfjpjnzcezkhskacy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_CONTENT_DB_SERVICE_ROLE_KEY

# Optional READ-ONLY bridge to the existing Outreach Engine database.
# This Social Hub never writes to these variables/database.
OUTREACH_SUPABASE_URL=https://zhlaaaysvzqixnugqbna.supabase.co
OUTREACH_SUPABASE_SERVICE_ROLE_KEY=PASTE_OUTREACH_DB_SERVICE_ROLE_KEY

# Internal app security
CONNECTOR_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
OAUTH_STATE_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE
CLICK_HASH_SALT=GENERATE_ANOTHER_RANDOM_VALUE
CONNECTOR_PUBLIC_URL=https://YOUR-NEW-SOCIAL-HUB.netlify.app

# Existing YouTube connector app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing Meta/Instagram app used by the Distributor
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=GENERATE_A_RANDOM_VERIFY_TOKEN


# Optional authentication settings.
# If SUPABASE_AUTH_KEY is omitted, the backend falls back to SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_AUTH_KEY may be your Supabase anon/publishable auth key.
SUPABASE_AUTH_KEY=

# Registration code required only when creating a new user.
# Defaults to alchemic2026 when omitted.
MEDIA_REGISTRATION_CODE=alchemic2026


# Facebook Pages / Messenger
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0

# Shared Meta webhook verification token used for Instagram + Facebook Page webhooks.
META_WEBHOOK_VERIFY_TOKEN=
